---
// Cabecera blanca fija a todo el ancho con canto de cemento: marca (bloque naranja inclinado) + menú + teléfono +
// botón de WhatsApp (siempre visible si hay WhatsApp) + botón `boton_cabecera`. En móvil: WhatsApp y menú
// plegable sin JavaScript (<details>). Estilos: .cabecera--tabique en src/styles/global.css.
import { site, tel, whatsapp, mensajeWhatsapp } from '../data/site';
import type { Enlace } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string; cta?: Enlace | null }
const { variante = 'tabique', cta = null } = Astro.props;
const c = site.contacto;
---

<header class={`cabecera cabecera--${variante}`}>
  <div class="contenedor cabecera-fila">
    <a href="/" class="marca" aria-label={`${site.nombre}, inicio`}>
      {
        site.logo ? (
          <img src={site.logo} alt={site.nombre} class="marca-logo" width="160" height="40" />
        ) : (
          <>
            <span class="marca-inicial" aria-hidden="true"><span>{site.nombre.trim().charAt(0)}</span></span>
            <span class="marca-nombre">{site.nombre}</span>
          </>
        )
      }
    </a>
    <nav class="cabecera-nav" aria-label="Menú principal">
      {site.menu.map((e) => <a href={e.url}>{e.texto}</a>)}
    </nav>
    {
      c.telefono && (
        <a href={tel(c.telefono)} class="cabecera-telefono" aria-label={`Llamar al ${c.telefono}`}>
          <Icono nombre="telefono" tam={20} />
          <span>{c.telefono}</span>
        </a>
      )
    }
    {
      c.whatsapp && (
        <a href={whatsapp(c.whatsapp, mensajeWhatsapp())} class="cabecera-whatsapp" rel="noopener" target="_blank" aria-label="Escribir por WhatsApp">
          <Icono nombre="whatsapp" tam={20} />
          <span class="cabecera-whatsapp-texto">WhatsApp</span>
        </a>
      )
    }
    {cta && cta.url && <a href={cta.url} class="btn-acento cabecera-cta">{cta.texto}</a>}
    {
      site.menu.length > 0 && (
        <details class="menu-movil">
          <summary>
            <span class="menu-movil-icono" aria-hidden="true" />
            <span>Menú</span>
          </summary>
          <nav class="menu-movil-panel" aria-label="Menú">
            {site.menu.map((e) => <a href={e.url}>{e.texto}</a>)}
            {cta && cta.url && <a href={cta.url} class="btn-acento">{cta.texto}</a>}
          </nav>
        </details>
      )
    }
  </div>
</header>
<script is:inline>
  document.querySelectorAll('.menu-movil a').forEach(function (a) {
    a.addEventListener('click', function () { a.closest('details').open = false; });
  });
</script>
