---
// Pie carbón a todo el ancho con columnas: marca y redes, servicios, zonas y contacto (todo desde site.yaml).
// Servicios y zonas salen de esas secciones (o de las que usen su diseño con `tipo:`); si no hay, la columna no sale.
// Abajo, cinta naranja con franjas diagonales. «Web creada con NoExpertise» si marca_pie no es false.
// En móvil añade la barra inferior fija «Llamar / WhatsApp» (solo si hay teléfono o WhatsApp).
import { site, tel, mapa, whatsapp, buscarSeccion, mensajeWhatsapp } from '../data/site';
import Icono from './ui/Icono.astro';
import { rutaDeSeccion } from '../lib/multipagina';
interface Props { variante?: string }
const { variante = 'tabique' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
const servicios = buscarSeccion('servicios');
const zonas = buscarSeccion('zonas');
const columnas = [
  servicios && { titulo: servicios.s.antetitulo || servicios.s.titulo || '', url: rutaDeSeccion(servicios.id), items: servicios.s.items.map((i) => i.titulo).filter(Boolean).slice(0, 8) },
  zonas && { titulo: zonas.s.antetitulo || zonas.s.titulo || '', url: rutaDeSeccion(zonas.id), items: zonas.s.items.map((i) => i.titulo).filter(Boolean).slice(0, 8) },
].filter((col) => col && col.items.length > 0) as { titulo: string; url: string; items: string[] }[];
---

<footer class={`pie pie--${variante}`}>
  <div class="contenedor pie-rejilla">
    <div class="pie-marca">
      <p class="pie-nombre">{site.nombre}</p>
      {site.eslogan && <p class="pie-eslogan">{site.eslogan}</p>}
      {
        redes.length > 0 && (
          <ul class="pie-redes">
            {redes.map(([red, url]) => (
              <li>
                <a href={url} rel="noopener" target="_blank" aria-label={red}>
                  <Icono nombre={red} tam={20} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    {
      columnas.map((col) => (
        <div>
          {col.titulo && <p class="pie-titulo">{col.titulo}</p>}
          <ul class="pie-lista">
            {col.items.map((t) => <li><a href={col.url}>{t}</a></li>)}
          </ul>
        </div>
      ))
    }
    <div>
      <p class="pie-titulo">Contacto</p>
      <ul class="pie-lista">
        {c.telefono && <li><a href={tel(c.telefono)} class="font-display text-2xl font-black text-white">{c.telefono}</a></li>}
        {c.whatsapp && <li><a href={whatsapp(c.whatsapp, mensajeWhatsapp())} rel="noopener" target="_blank">WhatsApp {c.whatsapp}</a></li>}
        {c.email && <li><a href={`mailto:${c.email}`} class="break-words">{c.email}</a></li>}
        {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
        {c.horario && <li class="text-sm opacity-75">{c.horario}</li>}
      </ul>
    </div>
  </div>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span class="pie-noexpertise">
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
  <div class="pie-cinta" aria-hidden="true"></div>
</footer>
{
  (c.telefono || c.whatsapp) && (
    <nav class="barra-movil" aria-label="Contacto rápido">
      {c.telefono && (
        <a class="barra-movil-llamar" href={tel(c.telefono)}>
          <Icono nombre="telefono" tam={20} />
          Llamar
        </a>
      )}
      {c.whatsapp && (
        <a class="barra-movil-whatsapp" href={whatsapp(c.whatsapp, mensajeWhatsapp())} rel="noopener" target="_blank">
          <Icono nombre="whatsapp" tam={20} />
          WhatsApp
        </a>
      )}
    </nav>
  )
}
