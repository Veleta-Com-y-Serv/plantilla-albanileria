---
// Servicios: banda blanca; titular partido (título a la izquierda, texto y botón a la derecha) y debajo una «pared»
// de bloques a todo el ancho del contenedor: cada servicio es un bloque blanco y la junta de mortero es el fondo
// de cemento que asoma entre ellos (1 columna en móvil, 2 en tableta, 3 en escritorio). Al pasar, el bloque se
// pone naranja. Campos: items[] {titulo, texto, icono}, cta opcional. Sin servicios, solo el titular.
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const items = s ? s.items.filter((i) => i.titulo) : [];
---

{
  s && (
    <section id={id} class="seccion bg-fondo">
      <div class="contenedor">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-12">
          <Titular class="mb-0 lg:col-span-7" antetitulo={s.antetitulo} titulo={s.titulo} />
          {(s.texto || s.cta?.url) && (
            <div class="lg:col-span-5">
              {s.texto && <p class="text-lg text-[var(--c-tenue)]">{s.texto}</p>}
              {s.cta?.url && (
                <a class="enlace-flecha mt-4" href={s.cta.url}>
                  {s.cta.texto}
                  <Icono nombre="flecha" tam={16} class="flecha" />
                </a>
              )}
            </div>
          )}
        </div>
        {items.length > 0 && (
          <ul class="pared mt-12 md:mt-16">
            {items.map((it, i) => (
              <li class="bloque">
                <div class="flex items-start justify-between gap-4">
                  <span class="icono-bloque"><Icono nombre={it.icono || 'ladrillos'} tam={26} /></span>
                  <span class="bloque-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                </div>
                <h3 class="mt-7 text-[1.55rem] leading-[.98] md:text-[1.8rem]">{it.titulo}</h3>
                {it.texto && <p class="mt-3 text-[var(--c-tenue)]">{it.texto}</p>}
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .pared { display: grid; gap: 6px; padding: 6px; background: var(--c-cemento-2); }
  @media (min-width: 640px) { .pared { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .pared { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .bloque { background: var(--c-fondo); padding: 1.75rem 1.5rem 2rem; transition: background-color .2s ease, color .2s ease; }
  @media (min-width: 768px) { .bloque { padding: 2.25rem 2rem 2.5rem; min-height: 17rem; } }
  .bloque-num { font-family: var(--fuente-titulos); font-weight: 900; font-size: 2.6rem; line-height: 1; color: transparent; -webkit-text-stroke: 2px var(--c-cemento-2); }
  .bloque:hover { background: var(--c-acento); color: var(--c-sobre-acento); }
  .bloque:hover p { color: inherit; }
  .bloque:hover .icono-bloque { background: var(--c-carbon); color: #fff; }
  .bloque:hover .bloque-num { -webkit-text-stroke-color: var(--c-sobre-acento); }
</style>
