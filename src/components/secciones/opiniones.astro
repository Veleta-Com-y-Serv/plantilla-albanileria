---
// Opiniones: banda blanca. La primera opinión va enorme a la izquierda con unas comillas naranjas gigantes; el resto,
// apiladas a la derecha entre filetes gruesos (en móvil, todas seguidas). Campos: testimonios[] {texto, autor, nota}
// (`nota` = el trabajo y el sitio). Sin opiniones no se pinta.
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const ops = s ? s.testimonios.filter((t) => t.texto) : [];
const [primera, ...resto] = ops;
---

{
  s && primera && (
    <section id={id} class="seccion bg-fondo">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        <div class:list={['grid gap-10', resto.length > 0 && 'lg:grid-cols-12 lg:gap-16']}>
          <figure class:list={['opinion-grande', resto.length > 0 && 'lg:col-span-7']}>
            <span class="comillas" aria-hidden="true">“</span>
            <blockquote class="font-display text-[clamp(1.5rem,3vw,2.5rem)] font-black uppercase leading-[1.05]">{primera.texto}</blockquote>
            {(primera.autor || primera.nota) && (
              <figcaption class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1">
                {primera.autor && <span class="etiqueta"><span>{primera.autor}</span></span>}
                {primera.nota && <span class="text-[var(--c-tenue)]">{primera.nota}</span>}
              </figcaption>
            )}
          </figure>
          {resto.length > 0 && (
            <ul class="lg:col-span-5">
              {resto.map((o) => (
                <li class="border-t-4 border-texto py-6 last:border-b-4">
                  <blockquote class="text-lg leading-snug">«{o.texto}»</blockquote>
                  {(o.autor || o.nota) && (
                    <p class="mt-3 text-sm">
                      {o.autor && <strong class="font-display font-black uppercase tracking-wide">{o.autor}</strong>}
                      {o.autor && o.nota && <span aria-hidden="true"> · </span>}
                      {o.nota && <span class="text-[var(--c-tenue)]">{o.nota}</span>}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .opinion-grande { position: relative; padding-top: 3.5rem; }
  .comillas { position: absolute; top: -1.5rem; left: -.3rem; font-family: Georgia, "Times New Roman", serif; font-size: 9rem; line-height: 1; color: var(--c-acento); }
  @media (min-width: 768px) { .comillas { font-size: 12rem; top: -2.5rem; } .opinion-grande { padding-top: 4.5rem; } }
</style>
