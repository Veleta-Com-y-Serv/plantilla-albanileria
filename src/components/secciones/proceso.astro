---
// Proceso: banda blanca; los pasos se apilan como una escalera de bloques que sube de izquierda a derecha
// (en escritorio, columnas cada vez más altas apoyadas en el mismo suelo; en móvil, bloques que se van
// sangrando hacia la derecha). El último bloque va en naranja. Número grande hueco, título y texto.
// Campos: items[] {titulo, texto}, cta opcional. Sin pasos, solo el titular.
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const pasos = s ? s.items.filter((i) => i.titulo) : [];
const n = pasos.length;
---

{
  s && (
    <section id={id} class="seccion bg-fondo">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        {n > 0 && (
          <ol class="escalera" style={`--n:${Math.min(n, 6)}`}>
            {pasos.map((p, i) => (
              <li class:list={['peldano', { 'peldano--ultimo': i === n - 1 }]} style={`--i:${i}`}>
                <span class="peldano-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-3 text-[1.3rem] leading-none md:text-[1.45rem]">{p.titulo}</h3>
                {p.texto && <p class="peldano-texto">{p.texto}</p>}
              </li>
            ))}
          </ol>
        )}
        {s.cta?.url && (
          <a class="btn-acento mt-10" href={s.cta.url}>{s.cta.texto}<Icono nombre="flecha" tam={18} class="flecha" /></a>
        )}
      </div>
    </section>
  )
}

<style>
  .escalera { display: grid; gap: 6px; border-bottom: 8px solid var(--c-carbon); }
  .peldano { margin-left: calc(var(--i) * .9rem); padding: 1.25rem 1.25rem 1.5rem; background: var(--c-cemento); border-top: 6px solid var(--c-cemento-2); }
  .peldano-num { display: block; font-family: var(--fuente-titulos); font-weight: 900; font-size: 2.75rem; line-height: 1; color: transparent; -webkit-text-stroke: 2px var(--c-texto); }
  .peldano-texto { margin-top: .6rem; color: var(--c-tenue); font-size: 1rem; }
  .peldano--ultimo { background: var(--c-acento); color: var(--c-sobre-acento); border-top-color: color-mix(in srgb, var(--c-acento) 70%, #000); }
  .peldano--ultimo .peldano-texto { color: inherit; }
  .peldano--ultimo .peldano-num { -webkit-text-stroke-color: var(--c-sobre-acento); }
  @media (min-width: 900px) {
    .escalera { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); align-items: end; }
    .peldano { margin-left: 0; min-height: calc(13rem + var(--i) * 3.25rem); padding: 1.5rem 1.4rem 1.75rem; display: flex; flex-direction: column; justify-content: flex-start; }
    .peldano-num { font-size: 3.5rem; }
  }
</style>
