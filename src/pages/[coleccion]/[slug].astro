---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /servicios/<slug>/.
// Diseño «obra con rayado»: banda de cemento claro con rayado de plano, migas y cabecera partida (etiqueta de cinta,
// título gigante en mayúsculas, texto, precio y botones de presupuesto y WhatsApp; a la derecha la foto con el canto
// en diagonal o, sin foto, el icono en un bloque naranja); banda blanca con el `detalle` y, al lado, la tabla de datos
// y la caja de presupuesto en carbón; franja de fotos (`imagenes`) en carbón con corte en diagonal; y los otros
// servicios como una pared de bloques con su junta de mortero.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const presupuesto = seccion('presupuesto') ? enlace('/#presupuesto') : site.boton_cabecera?.url || enlace('/#contacto');
const textoPresupuesto = site.boton_cabecera?.texto || 'Pide presupuesto';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio');
const fotos = f.imagenes.filter((src) => src !== f.imagen);
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda-cemento rayado ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="etiqueta"><span>{f.categoria || f.def.nombre}</span></p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {f.precio && <p class="ficha-chips"><span class="ficha-precio">{f.precio}</span></p>}
          <div class="ficha-botones">
            <a class="btn-acento" href={presupuesto}>{textoPresupuesto}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad respaldo="/placeholders/obra.svg" class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><span class="icono-bloque ficha-icono-caja"><Icono nombre={f.icono || 'ladrillos'} tam={72} /></span></div>
        )}
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio">{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-caja banda-carbon">
          <p class="ficha-caja-titulo">¿Tienes una obra así?</p>
          <p class="ficha-caja-texto">Voy a verla, te cuento qué hace falta y te dejo el precio cerrado por escrito.</p>
          <a class="btn-acento" href={presupuesto}>{textoPresupuesto}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {fotos.length > 0 && (
    <section class="banda-carbon rayado-claro ficha-fotos" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {fotos.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} respaldo="/placeholders/obra.svg" class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda-cemento rayado seccion">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otros servicios" />
        <ul class="pared">
          {otras.map((o) => (
            <li class="bloque">
              <span class="icono-bloque"><Icono nombre={o.icono || 'ladrillos'} tam={26} /></span>
              <h3><a href={o.url} class="bloque-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <span class="bloque-ver" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-oscuro" href={rutaDeSeccion(f.idSeccion)}>Ver todos los servicios</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.25rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .6rem; font-family: var(--fuente-titulos); font-size: .78rem; font-weight: 900; text-transform: uppercase; letter-spacing: .06em; }
  .migas li { display: inline-flex; align-items: center; gap: .6rem; min-width: 0; }
  .migas li + li::before { content: "/"; color: var(--c-acento-texto); }
  .migas a { text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { color: var(--c-acento-texto); }
  .migas [aria-current] { opacity: .7; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(.5rem, 2vw, 1.5rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.2rem, 8vw, 4.75rem); overflow-wrap: anywhere; }
  .ficha-chips { margin-top: 1.5rem; }
  .ficha-precio { font-family: var(--fuente-titulos); font-weight: 900; font-size: 1.35rem; color: var(--c-acento-texto); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; overflow: hidden; background: var(--c-cemento-2); clip-path: polygon(0 1.5rem, 100% 0, 100% 100%, 0 100%); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--c-cemento-2); }
  .ficha-icono-caja { width: 8rem; height: 8rem; }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.25rem; font-weight: 600; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.35rem; margin-bottom: 1rem; }
  .ficha-datos { background: var(--c-cemento); border-top: 6px solid var(--c-acento); padding: 1.5rem; }
  .ficha-datos dl { display: grid; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 2px solid var(--c-cemento-2); }
  .ficha-datos dt { font-weight: 800; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 700; min-width: 0; overflow-wrap: anywhere; }
  .ficha-caja { display: grid; gap: .9rem; padding: 1.75rem 1.5rem; }
  .ficha-caja-titulo { font-family: var(--fuente-titulos); font-size: 1.6rem; font-weight: 900; line-height: .98; text-transform: uppercase; }
  .ficha-caja-texto { opacity: .85; }
  .ficha-caja .btn-acento { justify-self: start; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-family: var(--fuente-titulos); font-weight: 900; color: #fff; text-decoration: none; }
  .ficha-fotos { padding-block: var(--ritmo); }
  .ficha-galeria { display: grid; gap: .5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; overflow: hidden; }
  .pared { display: grid; gap: 6px; padding: 6px; background: var(--c-cemento-2); }
  @media (min-width: 640px) { .pared { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .pared { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .bloque { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: .8rem; background: var(--c-fondo); padding: 1.75rem 1.5rem 2rem; transition: background-color .2s ease, color .2s ease; }
  .bloque h3 { font-size: 1.5rem; margin-top: .6rem; overflow-wrap: anywhere; }
  .bloque p { color: var(--c-tenue); }
  .bloque-enlace { text-decoration: none; color: inherit; }
  .bloque-enlace::after { content: ""; position: absolute; inset: 0; }
  .bloque-enlace:focus-visible { outline: none; }
  .bloque:has(.bloque-enlace:focus-visible) { outline: 3px solid var(--c-acento); outline-offset: -3px; }
  .bloque-ver { display: inline-flex; align-items: center; gap: .3rem; margin-top: auto; padding-top: .5rem; font-family: var(--fuente-titulos); font-weight: 900; font-size: .85rem; text-transform: uppercase; letter-spacing: .06em; }
  .bloque:hover { background: var(--c-acento); color: var(--c-sobre-acento); }
  .bloque:hover p { color: inherit; }
  .bloque:hover .icono-bloque { background: var(--c-carbon); color: #fff; }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-foto { clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%); }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
